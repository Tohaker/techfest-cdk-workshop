{
  "name": "techfest-cdk-workshop",
  "version": "0.1.0",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "test": "vitest",
    "cdk": "cdk",
    "cdk:prepare": "floci start --detach && cdk bootstrap",
    "cdk:deploy": "cdk deploy --all --require-approval never",
    "cdk:destroy": "cdk destroy --all --force",
    "cdk:diff": "cdk diff"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "aws-cdk": "2.1137.0",
    "tsx": "4.23.12",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  },
  "dependencies": {
    "aws-cdk-lib": "2.265.0",
    "constructs": "10.8.1"
  }
}