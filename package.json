{
	"name": "techfest-cdk-workshop",
	"version": "0.1.0",
	"type": "module",
	"scripts": {
		"build": "tsc",
		"watch": "tsc -w",
		"test": "vitest",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"cdk": "cdk",
		"cdk:prepare": "floci start --detach --pull=latest && cdk bootstrap",
		"cdk:deploy": "cdk deploy --all --require-approval never",
		"cdk:destroy": "cdk destroy --all --force",
		"cdk:diff": "cdk diff",
		"task:logs": "tsx scripts/printLogs.ts",
		"task:upload": "tsx scripts/uploadFile.ts"
	},
	"devDependencies": {
		"@aws-sdk/client-cloudwatch-logs": "3.1146.0",
		"@biomejs/biome": "2.5.14",
		"@types/aws-lambda": "8.10.164",
		"@types/node": "26.6.3",
		"aws-cdk": "2.1144.0",
		"tsx": "4.23.15",
		"typescript": "7.0.2",
		"vitest": "5.0.2"
	},
	"dependencies": {
		"@aws-lambda-powertools/batch": "2.36.0",
		"@aws-lambda-powertools/logger": "2.36.0",
		"@aws-sdk/client-dynamodb": "3.1146.0",
		"@aws-sdk/client-s3": "3.1146.0",
		"@aws-sdk/util-dynamodb": "3.996.9",
		"aws-cdk-lib": "2.272.0",
		"constructs": "10.8.1"
	}
}
